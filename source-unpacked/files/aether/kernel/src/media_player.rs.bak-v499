//! Native Aether media player core.
//! Streaming VFS reader + bounded PCM buffer. The decoder boundary is format
//! aware; WAV/PCM is the first native decoder and feeds the future HDA backend.

use crate::fs;
use crate::serial;
use crate::media_builtin;

const MAX_PATH: usize = 96;
const HEADER_BUF: usize = 4096;
const PCM_BUF: usize = 49152;
/// Single HDA playback rate. All PCM is resampled to this before DMA.
/// Native 44.1 on AH532 ALC269 often clocks wrong → accelerated pitch.
const TARGET_HDA_RATE: u32 = 48000;
/// Fixed-point duration multiplier applied at PCM emit (1000=1x, 2000=2x).
/// AH532 path was observed ~2x fast independent of FMT; this restores wall-clock
/// duration. Set to 1000 only after WALCLK proves 1x.
const PLAYBACK_SLOWDOWN_Q: u32 = 1000;
const MP3_INPUT_BUF: usize = 16384;
const MP3_FRAME_SAMPLES: usize = 1152 * 2;
const MAX_PLAYLIST: usize = 16;

#[derive(Clone, Copy, PartialEq)]
pub enum State { Empty, Stopped, Playing, Paused, Error }

#[derive(Clone, Copy, PartialEq)]
pub enum Format { Unknown, WavPcm, Mp3 }

static mut STATE: State = State::Empty;
static mut FORMAT: Format = Format::Unknown;
static mut PATH: [u8; MAX_PATH] = [0; MAX_PATH];
static mut PATH_LEN: usize = 0;
static mut TITLE: [u8; MAX_PATH] = [0; MAX_PATH];
static mut TITLE_LEN: usize = 0;
static mut FILE_SIZE: usize = 0;
/// What HDA is programmed for (always TARGET after play).
static mut SAMPLE_RATE: u32 = 0;
static mut CHANNELS: u16 = 0;
static mut BITS: u16 = 0;
/// Original file format (never overwritten by play()).
static mut SRC_RATE: u32 = 0;
static mut SRC_CH: u16 = 0;
static mut SRC_BITS: u16 = 0;
static mut DATA_OFF: usize = 0;
static mut DATA_LEN: usize = 0;
static mut PCM_FILE_POS: usize = 0;
static mut PCM_READY: usize = 0;
/// Scratch for one chunk of source PCM before rate/channel convert.
static mut SRC_TMP: [u8; 8192] = [0; 8192];
static mut VOLUME: u8 = 100;
static mut MUTED: bool = false;
static mut REPEAT: bool = false;
static mut SHUFFLE: bool = false;
static mut LAST_ERROR: u8 = 0;
static mut PCM: [u8; PCM_BUF] = [0; PCM_BUF];
static mut PLAYLIST: [[u8; MAX_PATH]; MAX_PLAYLIST] = [[0; MAX_PATH]; MAX_PLAYLIST];
static mut PL_LEN: [usize; MAX_PLAYLIST] = [0; MAX_PLAYLIST];
static mut PL_COUNT: usize = 0;
static mut PL_INDEX: usize = 0;
static mut BUILTIN_ACTIVE: u8 = 0;
static mut SELECTED_BUILTIN: usize = 0;
/// Non-zero = stream from NTFS MFT record (not VFS/builtin).
static mut NTFS_MFT_REF: u32 = 0;
static mut SOURCE_NTFS: bool = false;
static mut ALARM_SYNTH: bool = false;
static mut MP3_DECODER: crate::mp3_decoder::Decoder = crate::mp3_decoder::Decoder::new();
static mut MP3_INPUT: [u8; MP3_INPUT_BUF] = [0; MP3_INPUT_BUF];
static mut MP3_INPUT_LEN: usize = 0;
static mut MP3_FILE_POS: usize = 0;
static mut MP3_FRAME: [f32; MP3_FRAME_SAMPLES] = [0.0; MP3_FRAME_SAMPLES];

fn le16(b: &[u8], p: usize) -> u16 { (b[p] as u16) | ((b[p+1] as u16) << 8) }
fn le32(b: &[u8], p: usize) -> u32 {
    (b[p] as u32) | ((b[p+1] as u32) << 8) | ((b[p+2] as u32) << 16) | ((b[p+3] as u32) << 24)
}
fn copy_bytes(dst: &mut [u8], src: &[u8]) -> usize {
    let n=dst.len().min(src.len()); let mut i=0; while i<n { dst[i]=src[i]; i+=1; } n
}
fn four(b:&[u8],p:usize,s:&[u8;4])->bool { p+4<=b.len() && b[p..p+4]==s[..] }

fn parse_wav_bytes(b:&[u8])->Option<(usize,u32,u16,u16,usize,usize)> {
    if b.len()<12 || !four(b,0,b"RIFF") || !four(b,8,b"WAVE") { return None; }
    let mut p=12usize; let mut rate=0u32; let mut ch=0u16; let mut bits=0u16;
    let mut data_off=0usize; let mut data_len=0usize; let mut fmt=false;
    while p+8<=b.len() {
        let sz=le32(b,p+4) as usize; let body=p+8;
        let end=body.checked_add(sz)?;
        if end>b.len() { return None; }
        if four(b,p,b"fmt ") && sz>=16 {
            if le16(b,body)!=1 { return None; }
            ch=le16(b,body+2); rate=le32(b,body+4); bits=le16(b,body+14);
            if rate==0 || (ch!=1 && ch!=2) || (bits!=8 && bits!=16) { return None; }
            fmt=true;
        } else if four(b,p,b"data") {
            data_off=body; data_len=sz.min(b.len().saturating_sub(body));
            let frame=((ch as usize)*(bits as usize))/8;
            if frame==0 { return None; }
            data_len-=data_len%frame;
            return if fmt { Some((b.len(),rate,ch,bits,data_off,data_len)) } else { None };
        }
        p=end+(sz&1);
    }
    None
}

pub fn builtin_count()->usize { 1 }
pub fn builtin_name(i:usize)->&'static str {
    match i {
        0 => "Mozart Theme (MP3)",
        _ => "",
    }
}
pub fn builtin_kind(i:usize)->&'static str {
    match i {
        0 => "MP3 160k",
        _ => "",
    }
}
pub fn builtin_bytes(i:usize)->&'static [u8] {
    match i {
        0 => media_builtin::MOZART_MP3,
        _ => &[],
    }
}
pub fn selected_builtin()->usize { unsafe { SELECTED_BUILTIN } }
pub fn select_builtin(i:usize)->bool {
    if i>=builtin_count() { return false; }
    unsafe { SELECTED_BUILTIN=i; }
    true
}

pub fn builtin_path(i:usize)->&'static str {
    match i {
        0 => "/MEDIA/MOZART.MP3",
        _ => "",
    }
}

/// Map explorer / VFS path to embedded builtin index when the file is a bundled track.
pub fn builtin_index_for_path(path: &str) -> Option<usize> {
    let p = path.as_bytes();
    // Case-insensitive match on leaf name.
    let leaf = {
        let mut last = 0usize;
        let mut i = 0usize;
        while i < p.len() {
            if p[i] == b'/' || p[i] == b'\\' {
                last = i + 1;
            }
            i += 1;
        }
        &p[last..]
    };
    let eq = |a: &[u8], b: &[u8]| {
        if a.len() != b.len() {
            return false;
        }
        let mut i = 0;
        while i < a.len() {
            let ca = if a[i] >= b'a' && a[i] <= b'z' { a[i] - 32 } else { a[i] };
            let cb = if b[i] >= b'a' && b[i] <= b'z' { b[i] - 32 } else { b[i] };
            if ca != cb {
                return false;
            }
            i += 1;
        }
        true
    };
    if eq(leaf, b"MOZART.MP3") || eq(leaf, b"MOZART.WAV") {
        Some(0)
    } else {
        None
    }
}

pub fn is_audio_path(path: &str) -> bool {
    is_mp3_path(path) || is_wav_path(path)
}

fn is_wav_path(path: &str) -> bool {
    let b = path.as_bytes();
    if b.len() < 4 {
        return false;
    }
    let n = b.len();
    let c0 = b[n - 4];
    let c1 = b[n - 3];
    let c2 = b[n - 2];
    let c3 = b[n - 1];
    (c0 == b'.')
        && (c1 == b'w' || c1 == b'W')
        && (c2 == b'a' || c2 == b'A')
        && (c3 == b'v' || c3 == b'V')
}

/// Open a path chosen from Explorer. Prefers embedded media for /MEDIA/* tracks,
/// otherwise streams from AetherFS when the file exists there.
pub fn open_from_explorer(path: &str) -> bool {
    if path.is_empty() {
        return false;
    }
    // Only explicit bundled tracks map to embedded payload.
    if let Some(i) = builtin_index_for_path(path) {
        serial::write_str("[MEDIA] explorer -> builtin
");
        unsafe { SOURCE_NTFS = false; NTFS_MFT_REF = 0; }
        return open_builtin(i);
    }
    // Real VFS path (AetherFS) — never substitute Mozart for disk files.
    if open(path) {
        unsafe { SOURCE_NTFS = false; NTFS_MFT_REF = 0; }
        return true;
    }
    serial::write_str("[MEDIA] explorer open FAIL
");
    false
}

/// Open audio file from NTFS by MFT record (hard disk Explorer).
pub fn open_from_ntfs(mft_ref: u32, name: &[u8]) -> bool {
    if mft_ref == 0 {
        return false;
    }
    // Extension check
    let mut path_buf = [0u8; 96];
    let nlen = name.len().min(90);
    let mut i = 0usize;
    while i < nlen {
        path_buf[i] = name[i];
        i += 1;
    }
    let path = unsafe { core::str::from_utf8_unchecked(&path_buf[..nlen]) };
    if !is_audio_path(path) {
        return false;
    }
    // CRITICAL: stop DMA before resetting decoder — concurrent refill caused hang on track switch.
    hard_stop_playback();
    let size = match crate::fs_ntfs::file_data_size(mft_ref) {
        Some(s) if s > 0 => s,
        _ => return false,
    };
    // Streaming only — no whole-file load. Soft cap avoids absurd MFT sizes only.
    let size = if size > 512 * 1024 * 1024 { 512 * 1024 * 1024 } else { size };
    unsafe {
        SOURCE_NTFS = true;
        NTFS_MFT_REF = mft_ref;
        BUILTIN_ACTIVE = 0;
    }
    if is_mp3_path(path) {
        if open_mp3_common(path, size) {
            let _ = refill_mp3();
            serial::write_str("[MEDIA] NTFS MP3 mft=");
            serial::write_usize(mft_ref as usize);
            serial::write_str(" size=");
            serial::write_usize(size);
            serial::write_str("\n");
            return true;
        }
        return false;
    }
    // WAV from NTFS: load header via range, then stream
    let mut hdr = [0u8; 256];
    let n = match crate::fs_ntfs::read_file_range(mft_ref, 0, &mut hdr) {
        Some(v) => v,
        None => return false,
    };
    if let Some((_sz, rate, ch, bits, data, len)) = parse_wav_bytes(&hdr[..n]) {
        // data length may exceed header window — use file size
        let data_len = if data + len <= size { len } else { size.saturating_sub(data) };
        unsafe {
            PATH_LEN = copy_bytes(&mut PATH, path.as_bytes());
            TITLE_LEN = PATH_LEN.min(TITLE.len());
            let mut j = 0;
            while j < TITLE_LEN {
                TITLE[j] = PATH[j];
                j += 1;
            }
            FILE_SIZE = size;
            SAMPLE_RATE = rate;
            CHANNELS = ch;
            BITS = bits;
            SRC_RATE = rate;
            SRC_CH = ch;
            SRC_BITS = bits;
            DATA_OFF = data;
            DATA_LEN = data_len;
            PCM_FILE_POS = 0;
            PCM_READY = 0;
            FORMAT = Format::WavPcm;
            LAST_ERROR = 0;
            STATE = State::Stopped;
        }
        serial::write_str("[MEDIA] NTFS WAV opened rate=");
        serial::write_usize(rate as usize);
        serial::write_str(" ch=");
        serial::write_usize(ch as usize);
        serial::write_str("\n");
        return true;
    }
    false
}

pub fn open_embedded_wav()->bool {
    open_builtin(0)
}

pub fn open_builtin(i:usize)->bool {
    hard_stop_playback();
    unsafe { SOURCE_NTFS = false; NTFS_MFT_REF = 0; }
    let p=builtin_path(i);
    if p.is_empty(){return false;}
    let bytes=builtin_bytes(i);
    if bytes.is_empty(){return false;}
    add_to_playlist(p);

    // Always use kernel-embedded payload for builtins.
    // AetherFS only has tiny name stubs under /MEDIA — never open those as audio.
    if let Some((size,rate,ch,bits,data,len))=parse_wav_bytes(bytes) {
        unsafe {
            PATH_LEN=copy_bytes(&mut PATH,p.as_bytes());
            TITLE_LEN=PATH_LEN;
            let mut j=0; while j<TITLE_LEN { TITLE[j]=PATH[j]; j+=1; }
            FILE_SIZE=size; SAMPLE_RATE=rate; CHANNELS=ch; BITS=bits;
            SRC_RATE=rate; SRC_CH=ch; SRC_BITS=bits;
            DATA_OFF=data; DATA_LEN=len; PCM_FILE_POS=0; PCM_READY=0;
            FORMAT=Format::WavPcm; LAST_ERROR=0; STATE=State::Stopped;
            BUILTIN_ACTIVE=i as u8 + 1;
            SELECTED_BUILTIN=i;
        }
        serial::write_str("[MEDIA] embedded WAV ready rate=");
        serial::write_usize(rate as usize);
        serial::write_str("\n");
        return true;
    }
    if open_mp3_common(p, bytes.len()) {
        unsafe {
            BUILTIN_ACTIVE = i as u8 + 1;
            SELECTED_BUILTIN = i;
        }
        // Prime one MP3 frame so sample_rate is known before Play.
        let _ = refill_mp3();
        serial::write_str("[MEDIA] embedded MP3 ready\n");
        return true;
    }
    false
}

fn parse_wav(path:&str)->Option<(usize,u32,u16,u16,usize,usize)> {
    let size=fs::file_size(path)?;
    if size<12 { return None; }
    let mut h=[0u8;HEADER_BUF];
    let n=fs::read_range(path,0,&mut h)?;
    if n<12 || !four(&h,0,b"RIFF") || !four(&h,8,b"WAVE") { return None; }
    let mut p=12usize; let mut rate=0u32; let mut ch=0u16; let mut bits=0u16;
    let mut data_off=0usize; let mut data_len=0usize; let mut fmt=false;
    while p+8<=n {
        let sz=le32(&h,p+4) as usize; let body=p+8;
        let end=body.checked_add(sz)?;
        if end>size || end>n { 
            // Header chunks must be contained in the bounded header buffer.
            // If the data chunk starts beyond the header window, reject it
            // instead of reading unbounded metadata.
            return None;
        }
        if four(&h,p,b"fmt ") && sz>=16 {
            if le16(&h,body)!=1 { return None; }
            ch=le16(&h,body+2); rate=le32(&h,body+4); bits=le16(&h,body+14);
            if rate==0 || (ch!=1 && ch!=2) || (bits!=8 && bits!=16) { return None; }
            fmt=true;
        } else if four(&h,p,b"data") {
            data_off=body; data_len=sz; 
            if data_off.checked_add(data_len)? > size { return None; }
            data_len=(size-data_off).min(data_len);
            data_len-=data_len%(((ch as usize)*(bits as usize))/8).max(1);
            return if fmt { Some((size,rate,ch,bits,data_off,data_len)) } else { None };
        }
        p=end+(sz&1);
    }
    None
}

/// Always halt HDA DMA before touching decoder/PCM (track switch must not race DMA).
fn hard_stop_playback() {
    crate::drivers::audio::playback_stop();
    unsafe {
        if STATE == State::Playing || STATE == State::Paused {
            STATE = State::Stopped;
        }
        PCM_READY = 0;
        MP3_INPUT_LEN = 0;
    }
}

pub fn init() {
    unsafe {
        STATE=State::Empty; FORMAT=Format::Unknown; SELECTED_BUILTIN=0; PATH_LEN=0; TITLE_LEN=0;
        FILE_SIZE=0; SAMPLE_RATE=0; CHANNELS=0; BITS=0; DATA_OFF=0; DATA_LEN=0;
        PCM_FILE_POS=0; PCM_READY=0; MP3_INPUT_LEN=0; MP3_FILE_POS=0; MP3_DECODER=crate::mp3_decoder::Decoder::new(); VOLUME=100; MUTED=false;
        REPEAT=false; SHUFFLE=false; LAST_ERROR=0; PL_COUNT=0; PL_INDEX=0; BUILTIN_ACTIVE=0;
    }
    serial::write_str("[MEDIA] native streaming player core ready\n");
}

pub fn state()->State { unsafe{STATE} }
pub fn format()->Format { unsafe{FORMAT} }
pub fn volume()->u8 { unsafe{VOLUME} }
pub fn muted()->bool { unsafe{MUTED} }
pub fn repeat()->bool { unsafe{REPEAT} }
pub fn shuffle()->bool { unsafe{SHUFFLE} }
pub fn sample_rate()->u32 { unsafe{SAMPLE_RATE} }
pub fn channels()->u16 { unsafe{CHANNELS} }
pub fn bits()->u16 { unsafe{BITS} }
pub fn position_bytes()->usize { unsafe{if FORMAT==Format::Mp3 { MP3_FILE_POS } else { PCM_FILE_POS }} }
pub fn data_bytes()->usize { unsafe{DATA_LEN} }
pub fn file_size()->usize { unsafe{FILE_SIZE} }
pub fn error()->u8 { unsafe{LAST_ERROR} }
pub fn title(out:&mut [u8])->usize { unsafe{copy_bytes(out,&TITLE[..TITLE_LEN])} }
pub fn path(out:&mut [u8])->usize { unsafe{copy_bytes(out,&PATH[..PATH_LEN])} }

fn is_mp3_path(path:&str)->bool {
    let b=path.as_bytes();
    if b.len()<4 { return false; }
    let a=b[b.len()-4];
    let c=b[b.len()-3];
    let d=b[b.len()-2];
    let e=b[b.len()-1];
    (a==b'.') && ((c|0x20)==b'm') && ((d|0x20)==b'p') && ((e|0x20)==b'3')
}

fn open_mp3_common(path:&str, bytes_len:usize)->bool {
    if bytes_len==0 { unsafe{STATE=State::Error; LAST_ERROR=2;} return false; }
    hard_stop_playback();
    unsafe {
        PATH_LEN=copy_bytes(&mut PATH,path.as_bytes());
        TITLE_LEN=PATH_LEN.min(TITLE.len());
        let mut i=0; while i<TITLE_LEN { TITLE[i]=PATH[i]; i+=1; }
        FILE_SIZE=bytes_len; SAMPLE_RATE=0; CHANNELS=0; BITS=16;
        DATA_OFF=0; DATA_LEN=bytes_len; PCM_FILE_POS=0; PCM_READY=0;
        MP3_INPUT_LEN=0; MP3_FILE_POS=0;
        MP3_DECODER=crate::mp3_decoder::Decoder::new();
        FORMAT=Format::Mp3; LAST_ERROR=0; STATE=State::Stopped;
    }
    serial::write_str("[MEDIA] MP3 decoder opened\n");
    true
}

fn refill_mp3()->usize {
    // Decode multiple frames into PCM until we have a healthy buffer.
    // One frame (~4KB stereo) is not enough for HDA 4KB periods — underruns
    // sound as clicks/distortion. Keep residual MP3 input between calls.
    unsafe {
        if FORMAT != Format::Mp3 {
            PCM_READY = 0;
            return 0;
        }
        if PCM_READY > 24576 {
            return PCM_READY;
        }

        let mut out = PCM_READY; // append if residual PCM remains
        let mut frames = 0u32;
        let mut stalled = 0u32;

        while out + 4608 < PCM_BUF && frames < 8 {
            // Ensure MP3_INPUT has data starting at offset 0 with any residual first.
            if MP3_INPUT_LEN < 2048 && MP3_FILE_POS < FILE_SIZE {
                let space = MP3_INPUT_BUF - MP3_INPUT_LEN;
                let need = (FILE_SIZE - MP3_FILE_POS).min(space);
                if need > 0 {
                    let got = if BUILTIN_ACTIVE != 0 {
                        let bi = (BUILTIN_ACTIVE - 1) as usize;
                        let src = builtin_bytes(bi);
                        if MP3_FILE_POS >= src.len() {
                            0
                        } else {
                            let avail = (src.len() - MP3_FILE_POS).min(need);
                            let mut i = 0usize;
                            while i < avail {
                                MP3_INPUT[MP3_INPUT_LEN + i] = src[MP3_FILE_POS + i];
                                i += 1;
                            }
                            avail
                        }
                    } else if SOURCE_NTFS {
                        match crate::fs_ntfs::read_file_range(
                            NTFS_MFT_REF,
                            MP3_FILE_POS,
                            &mut MP3_INPUT[MP3_INPUT_LEN..MP3_INPUT_LEN + need],
                        ) {
                            Some(v) => v,
                            None => 0,
                        }
                    } else {
                        match fs::read_range(
                            core::str::from_utf8_unchecked(&PATH[..PATH_LEN]),
                            MP3_FILE_POS,
                            &mut MP3_INPUT[MP3_INPUT_LEN..MP3_INPUT_LEN + need],
                        ) {
                            Some(v) => v,
                            None => 0,
                        }
                    };
                    if got > 0 {
                        MP3_INPUT_LEN += got;
                        MP3_FILE_POS = MP3_FILE_POS.saturating_add(got);
                    }
                }
            }

            if MP3_INPUT_LEN == 0 {
                break;
            }

            let (consumed, info) =
                MP3_DECODER.decode(&MP3_INPUT[..MP3_INPUT_LEN], &mut MP3_FRAME);

            if consumed > 0 {
                // Keep residual bytes at the front of MP3_INPUT.
                let rest = MP3_INPUT_LEN - consumed;
                if rest > 0 {
                    let mut i = 0usize;
                    while i < rest {
                        MP3_INPUT[i] = MP3_INPUT[consumed + i];
                        i += 1;
                    }
                }
                MP3_INPUT_LEN = rest;
                stalled = 0;
            } else {
                stalled += 1;
                if stalled >= 3 {
                    // Need more data or EOF — stop filling this round.
                    break;
                }
                if MP3_FILE_POS >= FILE_SIZE {
                    break;
                }
                continue;
            }

            let info = match info {
                Some(v) => v,
                None => continue,
            };

            // minimp3 returns samples PER CHANNEL; PCM floats are interleaved.
            let src_rate = if info.sample_rate > 0 { info.sample_rate } else { 44100 };
            let ch_n = info.channels.num() as usize;
            let ch_n = if ch_n == 0 { 1 } else { ch_n.min(2) };
            let mut n_samp = info.samples_produced;
            // Cap to one granule set (1152 for MPEG1 Layer3).
            if n_samp > 1152 { n_samp = 1152; }
            if n_samp == 0 { continue; }
            SRC_RATE = src_rate;
            SRC_CH = ch_n as u16;
            SRC_BITS = 16;
            // Always emit stereo 16-bit @ TARGET_HDA_RATE so HDA FMT matches PCM density.
            SAMPLE_RATE = TARGET_HDA_RATE;
            CHANNELS = 2;
            BITS = 16;
            // out_frames = n_samp * 48000 / src_rate * slowdown
            // slowdown compensates measured 2x-fast playback on AH532.
            let out_frames = {
                let base = if src_rate == TARGET_HDA_RATE {
                    n_samp as u64
                } else {
                    (n_samp as u64) * (TARGET_HDA_RATE as u64) / (src_rate as u64)
                };
                (base * (PLAYBACK_SLOWDOWN_Q as u64) / 1000) as usize
            };
            // CRITICAL: map oi ∈ [0, out_frames) → source ∈ [0, n_samp).
            // Old code used oi * src_rate / 48000 and ignored PLAYBACK_SLOWDOWN_Q,
            // so the 2nd half of each expanded frame stuck on the last sample → harsh distortion.
            let mut oi = 0usize;
            let of = if out_frames == 0 { 1 } else { out_frames as u64 };
            let ns = n_samp as u64;
            while oi < out_frames && out + 3 < PCM_BUF {
                // Fixed-point 16.16 source index across the full output span.
                let pos16 = (oi as u64) * ns * 65536u64 / of;
                let si = (pos16 >> 16) as usize;
                let si = if si >= n_samp { n_samp.saturating_sub(1) } else { si };
                let si2 = if si + 1 < n_samp { si + 1 } else { si };
                let frac = (pos16 & 0xFFFF) as f32 / 65536.0;
                let li = si * ch_n;
                let ri = if ch_n >= 2 { li + 1 } else { li };
                let li2 = si2 * ch_n;
                let ri2 = if ch_n >= 2 { li2 + 1 } else { li2 };
                let xl0 = MP3_FRAME[li.min(MP3_FRAME_SAMPLES - 1)];
                let xr0 = MP3_FRAME[ri.min(MP3_FRAME_SAMPLES - 1)];
                let xl1 = MP3_FRAME[li2.min(MP3_FRAME_SAMPLES - 1)];
                let xr1 = MP3_FRAME[ri2.min(MP3_FRAME_SAMPLES - 1)];
                let mut xl = xl0 + (xl1 - xl0) * frac;
                let mut xr = xr0 + (xr1 - xr0) * frac;
                // Soft clip reduces harsh digital clipping vs hard clamp.
                if xl > 0.98 { xl = 0.98 + (xl - 0.98) * 0.05; }
                if xl < -0.98 { xl = -0.98 + (xl + 0.98) * 0.05; }
                if xr > 0.98 { xr = 0.98 + (xr - 0.98) * 0.05; }
                if xr < -0.98 { xr = -0.98 + (xr + 0.98) * 0.05; }
                if xl > 1.0 { xl = 1.0; }
                if xl < -1.0 { xl = -1.0; }
                if xr > 1.0 { xr = 1.0; }
                if xr < -1.0 { xr = -1.0; }
                // 0.95 headroom reduces intersample peaks on HDA DAC.
                let sl = (xl * 31129.0) as i16; // 32767 * 0.95
                let sr = (xr * 31129.0) as i16;
                let ul = sl as u16;
                let ur = sr as u16;
                PCM[out] = (ul & 0xFF) as u8;
                PCM[out + 1] = (ul >> 8) as u8;
                PCM[out + 2] = (ur & 0xFF) as u8;
                PCM[out + 3] = (ur >> 8) as u8;
                out += 4;
                oi += 1;
            }
            frames += 1;
        }

        PCM_READY = out;
        if out == 0 && MP3_FILE_POS >= FILE_SIZE {
            // true EOF
        } else if out == 0 {
            LAST_ERROR = 5;
        }
        out
    }
}

pub fn open(path:&str)->bool {
    hard_stop_playback();
    if is_mp3_path(path) {
        let size=match fs::file_size(path) {
            Some(v)=>v,
            None=>{unsafe{STATE=State::Error;FORMAT=Format::Unknown;LAST_ERROR=1;} return false;}
        };
        unsafe { BUILTIN_ACTIVE=0; }
        return open_mp3_common(path,size);
    }

    let (size,rate,ch,bits,data,len)=match parse_wav(path) {
        Some(v)=>v,
        None=>{unsafe{STATE=State::Error;FORMAT=Format::Unknown;LAST_ERROR=2;} serial::write_str("[MEDIA] unsupported or malformed WAV
"); return false;}
    };
    unsafe {
        BUILTIN_ACTIVE=0;
        PATH_LEN=copy_bytes(&mut PATH,path.as_bytes());
        TITLE_LEN=PATH_LEN.min(TITLE.len());
        let mut i=0; while i<TITLE_LEN { TITLE[i]=PATH[i]; i+=1; }
        FILE_SIZE=size; SAMPLE_RATE=rate; CHANNELS=ch; BITS=bits;
        SRC_RATE=rate; SRC_CH=ch; SRC_BITS=bits;
        DATA_OFF=data; DATA_LEN=len; PCM_FILE_POS=0; PCM_READY=0;
        FORMAT=Format::WavPcm; LAST_ERROR=0; STATE=State::Stopped;
    }
    serial::write_str("[MEDIA] WAV PCM opened\n");
    true
}

/// Convert source PCM chunk → 16-bit stereo @ TARGET_HDA_RATE into PCM[].
fn wav_convert_append(src: &[u8], src_rate: u32, src_ch: u16, src_bits: u16) -> usize {
    unsafe {
        if src_rate == 0 || src_ch == 0 {
            return 0;
        }
        let bpf = ((src_ch as usize) * (src_bits as usize)) / 8;
        if bpf == 0 {
            return 0;
        }
        let n_src = src.len() / bpf;
        if n_src == 0 {
            return 0;
        }
        // Resample to 48 kHz + duration slowdown (same as MP3 path).
        let out_frames = {
            let base = if src_rate == TARGET_HDA_RATE {
                n_src as u64
            } else {
                (n_src as u64) * (TARGET_HDA_RATE as u64) / (src_rate as u64)
            };
            (base * (PLAYBACK_SLOWDOWN_Q as u64) / 1000) as usize
        };
        SAMPLE_RATE = TARGET_HDA_RATE;
        CHANNELS = 2;
        BITS = 16;
        let mut out = PCM_READY;
        let mut oi = 0usize;
        let of = if out_frames == 0 { 1 } else { out_frames as u64 };
        let ns = n_src as u64;
        while oi < out_frames && out + 3 < PCM_BUF {
            // Map full out span → full source span (accounts for PLAYBACK_SLOWDOWN_Q).
            let src_pos = ((oi as u64) * ns / of) as usize;
            let src_pos = if src_pos >= n_src { n_src.saturating_sub(1) } else { src_pos };
            let base = src_pos * bpf;
            // Left
            let (mut sl, mut sr): (i32, i32) = (0, 0);
            if src_bits == 16 {
                let l = (src[base] as u16) | ((src[base + 1] as u16) << 8);
                sl = l as i16 as i32;
                if src_ch >= 2 && base + 3 < src.len() {
                    let r = (src[base + 2] as u16) | ((src[base + 3] as u16) << 8);
                    sr = r as i16 as i32;
                } else {
                    sr = sl;
                }
            } else {
                // 8-bit unsigned PCM
                let l = src[base] as i32 - 128;
                sl = l * 256;
                if src_ch >= 2 && base + 1 < src.len() {
                    let r = src[base + 1] as i32 - 128;
                    sr = r * 256;
                } else {
                    sr = sl;
                }
            }
            // Soft clamp
            if sl > 32767 {
                sl = 32767;
            }
            if sl < -32768 {
                sl = -32768;
            }
            // 0.95 headroom
            sl = (sl * 95) / 100;
            sr = (sr * 95) / 100;
            if sl > 32767 { sl = 32767; }
            if sl < -32768 { sl = -32768; }
            if sr > 32767 { sr = 32767; }
            if sr < -32768 { sr = -32768; }
            let ul = sl as i16 as u16;
            let ur = sr as i16 as u16;
            PCM[out] = (ul & 0xFF) as u8;
            PCM[out + 1] = (ul >> 8) as u8;
            PCM[out + 2] = (ur & 0xFF) as u8;
            PCM[out + 3] = (ur >> 8) as u8;
            out += 4;
            oi += 1;
        }
        let written = out - PCM_READY;
        PCM_READY = out;
        written
    }
}

fn synth_alarm_chunk() -> usize {
    unsafe {
        if PCM_READY > 24576 { return PCM_READY; }
        let rate = TARGET_HDA_RATE;
        let need_frames = ((PCM_BUF - PCM_READY) / 4).min(4096);
        let mut i = 0usize;
        let base_i = (PCM_FILE_POS / 4) as usize;
        while i < need_frames && PCM_READY + 4 <= PCM_BUF {
            let gi = base_i + i;
            let period = (rate as usize) * 35 / 100;
            let seg = if period == 0 { 0 } else { (gi / period) % 2 };
            let freq = if seg == 0 { 880u32 } else { 1320u32 };
            let phase = ((gi as u64 * freq as u64) / (rate as u64)) as u32;
            let mut s: i16 = if (phase & 1) == 0 { 12000 } else { -12000 };
            if period > 16 && (gi % period) > period.saturating_sub(period / 8) {
                s = 0;
            }
            let u = s as u16;
            let o = PCM_READY;
            PCM[o] = (u & 0xFF) as u8;
            PCM[o + 1] = (u >> 8) as u8;
            PCM[o + 2] = (u & 0xFF) as u8;
            PCM[o + 3] = (u >> 8) as u8;
            PCM_READY += 4;
            i += 1;
        }
        PCM_FILE_POS = PCM_FILE_POS.saturating_add(i * 4);
        // Loop forever while alarm synth active
        if PCM_FILE_POS > (TARGET_HDA_RATE as usize) * 16 * 4 {
            PCM_FILE_POS = 0;
        }
        PCM_READY
    }
}

pub fn refill_pcm()->usize {
    if unsafe { FORMAT==Format::Mp3 } { return refill_mp3(); }
    unsafe {
        if ALARM_SYNTH {
            return synth_alarm_chunk();
        }
        if FORMAT!=Format::WavPcm || DATA_LEN==0 || PCM_FILE_POS>=DATA_LEN {
            if PCM_FILE_POS >= DATA_LEN && PCM_READY == 0 {
                PCM_READY = 0;
            }
            return PCM_READY;
        }
        if PCM_READY > 24576 {
            return PCM_READY;
        }
        let src_rate = if SRC_RATE > 0 { SRC_RATE } else { SAMPLE_RATE };
        let src_ch = if SRC_CH > 0 { SRC_CH } else { CHANNELS };
        let src_bits = if SRC_BITS > 0 { SRC_BITS } else { BITS };
        let bpf = ((src_ch as usize) * (src_bits as usize)) / 8;
        if bpf == 0 {
            return 0;
        }
        let remain = DATA_LEN - PCM_FILE_POS;
        // Read enough source to fill ~4–8 KB of 48k stereo after convert
        let want_src = 4096usize.min(remain);
        let want_src = want_src - (want_src % bpf);
        if want_src == 0 {
            return PCM_READY;
        }
        let n = want_src.min(SRC_TMP.len());
        let n = n - (n % bpf);
        if n == 0 {
            return PCM_READY;
        }
        let got = if BUILTIN_ACTIVE != 0 {
            let bi = (BUILTIN_ACTIVE - 1) as usize;
            let src = builtin_bytes(bi);
            let off = DATA_OFF + PCM_FILE_POS;
            if off < src.len() {
                let avail = (src.len() - off).min(n);
                let avail = avail - (avail % bpf);
                let mut i = 0;
                while i < avail {
                    SRC_TMP[i] = src[off + i];
                    i += 1;
                }
                Some(avail)
            } else {
                None
            }
        } else if SOURCE_NTFS {
            crate::fs_ntfs::read_file_range(
                NTFS_MFT_REF,
                DATA_OFF + PCM_FILE_POS,
                &mut SRC_TMP[..n],
            )
        } else {
            fs::read_range(
                core::str::from_utf8_unchecked(&PATH[..PATH_LEN]),
                DATA_OFF + PCM_FILE_POS,
                &mut SRC_TMP[..n],
            )
        };
        match got {
            Some(got) if got >= bpf => {
                let got = got - (got % bpf);
                PCM_FILE_POS = PCM_FILE_POS.saturating_add(got);
                let _ = wav_convert_append(&SRC_TMP[..got], src_rate, src_ch, src_bits);
                PCM_READY
            }
            _ => {
                if PCM_READY == 0 {
                    LAST_ERROR = 3;
                    STATE = State::Error;
                }
                PCM_READY
            }
        }
    }
}

pub fn pcm_buffer(out:&mut [u8])->usize {
    unsafe {
        if PCM_READY < out.len() && STATE == State::Playing {
            let _ = refill_pcm();
        }
        let n=out.len().min(PCM_READY);
        let mut i=0;
        // Apply the player volume/mute state in the PCM sink path.
        // The HDA codec remains at the known-good hardware gain; UI volume
        // therefore changes only the samples that are sent to DMA.
        if MUTED || VOLUME == 0 {
            while i < n { out[i] = 0; i += 1; }
        } else if VOLUME >= 100 {
            while i < n { out[i] = PCM[i]; i += 1; }
        } else {
            // Current native HDA playback is 16-bit PCM. Scale complete
            // little-endian samples without changing the stream format.
            while i + 1 < n {
                let raw = (PCM[i] as u16) | ((PCM[i + 1] as u16) << 8);
                let sample = raw as i16 as i32;
                let scaled = sample * (VOLUME as i32) / 100;
                let s = scaled as i16;
                let u = s as u16;
                out[i] = (u & 0xFF) as u8;
                out[i + 1] = (u >> 8) as u8;
                i += 2;
            }
            while i < n { out[i] = PCM[i]; i += 1; }
        }
        n
    }
}

/// Called by the PCM sink after it has consumed n bytes.
pub fn consume_pcm(n: usize) {
    unsafe {
        let n = n.min(PCM_READY);
        if n == 0 {
            return;
        }
        // Slide remaining PCM to front (partial period consume).
        if n < PCM_READY {
            let rest = PCM_READY - n;
            let mut i = 0usize;
            while i < rest {
                PCM[i] = PCM[n + i];
                i += 1;
            }
            PCM_READY = rest;
        } else {
            PCM_READY = 0;
        }
        // WAV: PCM_FILE_POS advances in refill_pcm (source bytes), not here.
        // MP3: MP3_FILE_POS advances in refill_mp3.
        // Keep buffer topped up.
        if FORMAT == Format::Mp3 {
            if PCM_READY < 16384 && MP3_FILE_POS < FILE_SIZE {
                let _ = refill_mp3();
            }
            if PCM_READY == 0 && MP3_FILE_POS >= FILE_SIZE {
                if REPEAT {
                    MP3_FILE_POS = 0;
                    MP3_INPUT_LEN = 0;
                    MP3_DECODER = crate::mp3_decoder::Decoder::new();
                    PCM_READY = 0;
                    let _ = refill_mp3();
                } else {
                    STATE = State::Stopped;
                }
            }
        } else {
            if PCM_READY == 0 && PCM_FILE_POS < DATA_LEN {
                let _ = refill_pcm();
            }
            if PCM_FILE_POS >= DATA_LEN {
                if REPEAT {
                    PCM_FILE_POS = 0;
                    PCM_READY = 0;
                    let _ = refill_pcm();
                } else {
                    STATE = State::Stopped;
                    PCM_READY = 0;
                }
            }
        }
    }
}

pub fn play() {
    unsafe {
        // Allow restart from Error (previous false-negative RUN readback on AH532).
        if DATA_LEN > 0
            && (STATE == State::Stopped
                || STATE == State::Paused
                || STATE == State::Error)
        {
            STATE = State::Playing;
            PCM_FILE_POS = 0;
            PCM_READY = 0;
            if FORMAT == Format::Mp3 {
                MP3_FILE_POS = 0;
                MP3_INPUT_LEN = 0;
                MP3_DECODER = crate::mp3_decoder::Decoder::new();
            }
            // Prefill enough for a few HDA periods. Cap tries so NTFS switch
            // cannot freeze the desktop for seconds (sector-by-sector reads).
            let mut tries = 0u32;
            let max_tries = if SOURCE_NTFS { 12 } else { 32 };
            while PCM_READY < 16384 && tries < max_tries {
                let before = PCM_READY;
                let _ = refill_pcm();
                if PCM_READY == before { break; }
                tries += 1;
            }
            // PCM buffer is always TARGET_HDA_RATE stereo after refill_* resample.
            // Never program native 44.1 on AH532 — clock mismatch → accelerated audio.
            let rate = TARGET_HDA_RATE;
            SAMPLE_RATE = rate;
            CHANNELS = 2;
            BITS = 16;
            serial::write_str("[MEDIA] PLAY rate=");
            serial::write_usize(rate as usize);
            serial::write_str(" slowdown_q=");
            serial::write_usize(PLAYBACK_SLOWDOWN_Q as usize);
            serial::write_str(" src_rate=");
            serial::write_usize(SRC_RATE as usize);
            serial::write_str(" pcm=");
            serial::write_usize(PCM_READY);
            serial::write_str("\n");
            if !crate::drivers::audio::playback_start(rate, 2, 16) {
                // Fallback: 48 kHz if native rate rejected by HDA
                if rate != 48000 && crate::drivers::audio::playback_start(48000, 2, 16) {
                    SAMPLE_RATE = 48000;
                    LAST_ERROR = 0;
                } else {
                    STATE = State::Error;
                    LAST_ERROR = 6;
                }
            } else {
                LAST_ERROR = 0;
            }
        }
    }
}
pub fn pause(){unsafe{if STATE==State::Playing{crate::drivers::audio::playback_stop();STATE=State::Paused;}}}
pub fn stop(){crate::drivers::audio::playback_stop();unsafe{if DATA_LEN>0{PCM_FILE_POS=0;PCM_READY=0;let _=refill_pcm();STATE=State::Stopped;}}}
pub fn toggle_play(){
    unsafe {
        if STATE == State::Playing {
            crate::drivers::audio::playback_stop();
            STATE = State::Paused;
        } else if DATA_LEN > 0 {
            // Same path as play(): always HDA 48k stereo after convert
            play();
        }
    }
}

pub fn seek_permille(v:u16){
    unsafe{
        if DATA_LEN==0{return;}
        let x=v.min(1000) as usize;
        if FORMAT==Format::Mp3 {
            MP3_FILE_POS=(DATA_LEN*x)/1000;
            PCM_READY=0;
            MP3_INPUT_LEN=0;
            MP3_DECODER=crate::mp3_decoder::Decoder::new();
            if STATE==State::Playing { let _=refill_pcm(); }
            return;
        }
        let ch = if SRC_CH > 0 { SRC_CH } else { CHANNELS };
        let bits = if SRC_BITS > 0 { SRC_BITS } else { BITS };
        let frame = ((ch as usize) * (bits as usize)) / 8;
        if frame == 0 {
            return;
        }
        PCM_FILE_POS = ((DATA_LEN * x) / 1000 / frame) * frame;
        PCM_READY = 0;
        if STATE == State::Playing {
            let _ = refill_pcm();
        }
    }
}
pub fn set_volume(v:u8){unsafe{VOLUME=v.min(100);}}
pub fn volume_up(){unsafe{VOLUME=VOLUME.saturating_add(5).min(100);}}
pub fn volume_down(){unsafe{VOLUME=VOLUME.saturating_sub(5);}}
pub fn toggle_mute(){unsafe{MUTED=!MUTED;}}
pub fn toggle_repeat(){unsafe{REPEAT=!REPEAT;}}
pub fn toggle_shuffle(){unsafe{SHUFFLE=!SHUFFLE;}}

pub fn add_to_playlist(path:&str)->bool{
    unsafe{if PL_COUNT>=MAX_PLAYLIST{return false;}PL_LEN[PL_COUNT]=copy_bytes(&mut PLAYLIST[PL_COUNT],path.as_bytes());PL_COUNT+=1;true}
}
pub fn playlist_count()->usize{unsafe{PL_COUNT}}
pub fn next()->bool{
    unsafe{
        if PL_COUNT==0{return false;}
        if SHUFFLE{PL_INDEX=(PL_INDEX.wrapping_mul(7).wrapping_add(3))%PL_COUNT}
        else if PL_INDEX+1<PL_COUNT{PL_INDEX+=1}
        else if REPEAT{PL_INDEX=0}
        else{return false}
        let n=PL_LEN[PL_INDEX]; let mut p=[0u8;MAX_PATH]; let mut i=0; while i<n{p[i]=PLAYLIST[PL_INDEX][i];i+=1;}
        if let Ok(s)=core::str::from_utf8(&p[..n]) { open(s) } else { false }
    }
}

/// Synthetic dual-tone alarm into PCM (44100 Hz stereo 16-bit), then play via HDA.
/// Pattern: 880 Hz / 1320 Hz alternating 0.35s each, ~6 seconds, looped by REPEAT.
pub fn start_alarm_sound() -> bool {
    unsafe {
        SOURCE_NTFS = false;
        NTFS_MFT_REF = 0;
        BUILTIN_ACTIVE = 0;
        ALARM_SYNTH = true;
        FORMAT = Format::WavPcm;
        SRC_RATE = TARGET_HDA_RATE;
        SAMPLE_RATE = TARGET_HDA_RATE;
        SRC_CH = 2;
        CHANNELS = 2;
        SRC_BITS = 16;
        BITS = 16;
        DATA_OFF = 0;
        // Synthesize into PCM buffer as the "file" content via SRC_TMP style:
        // We fill PCM fully and treat as pre-buffered; DATA_LEN tracks virtual size.
        PCM_READY = 0;
        PCM_FILE_POS = 0;
        let rate = TARGET_HDA_RATE;
        let total_frames = (TARGET_HDA_RATE as usize) * 4; // 4 seconds of pattern
        // Generate into PCM buffer (limited by PCM_BUF) — will loop via REPEAT
        let max_frames = (PCM_BUF / 4).min(total_frames);
        let mut i = 0usize;
        while i < max_frames {
            // 0.35s periods alternate frequencies
            let period = (rate as usize) * 35 / 100;
            let seg = if period == 0 { 0 } else { (i / period) % 2 };
            let freq = if seg == 0 { 880u32 } else { 1320u32 };
            // Square wave (no_std, no sin)
            let phase = ((i as u64 * freq as u64) / (rate as u64)) as u32;
            let s: i16 = if (phase & 1) == 0 { 12000 } else { -12000 };
            // Brief silence gaps between segments for clearer alarm character
            let in_gap = period > 16 && (i % period) > period.saturating_sub(period / 8);
            let s = if in_gap { 0i16 } else { s };
            let u = s as u16;
            let o = i * 4;
            if o + 3 >= PCM_BUF {
                break;
            }
            PCM[o] = (u & 0xFF) as u8;
            PCM[o + 1] = (u >> 8) as u8;
            PCM[o + 2] = (u & 0xFF) as u8;
            PCM[o + 3] = (u >> 8) as u8;
            i += 1;
        }
        PCM_READY = i * 4;
        DATA_LEN = PCM_READY; // synthetic "file" is the buffer itself
        FILE_SIZE = DATA_LEN;
        PATH_LEN = copy_bytes(&mut PATH, b"<alarm>");
        TITLE_LEN = copy_bytes(&mut TITLE, b"Alarm");
        REPEAT = true;
        MUTED = false;
        if VOLUME < 40 {
            VOLUME = 80;
        }
        LAST_ERROR = 0;
        STATE = State::Stopped;
        // Use play path but PCM is already filled — avoid refill from empty source
        STATE = State::Playing;
        PCM_FILE_POS = 0;
        // Mark as synthetic: FORMAT WavPcm with DATA_LEN but refill returns existing PCM
        // Playback: start HDA
        if !crate::drivers::audio::playback_start(TARGET_HDA_RATE, 2, 16) {
            STATE = State::Error;
            LAST_ERROR = 6;
            serial::write_str("[MEDIA] ALARM HDA START FAIL (speaker fallback active)\n");
            return false;
        }
        serial::write_str("[MEDIA] ALARM SOUND START pcm=");
        serial::write_usize(PCM_READY);
        serial::write_str("\n");
        true
    }
}

pub fn stop_alarm_sound() {
    unsafe {
        ALARM_SYNTH = false;
        REPEAT = false;
        if STATE == State::Playing {
            crate::drivers::audio::playback_stop();
            STATE = State::Stopped;
        }
        PCM_READY = 0;
        DATA_LEN = 0;
    }
}
